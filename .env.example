# ImmoSafe DE - Environment Variables
# Copy this file to .env and fill in your values

# ════════════════════════════════════════════════════════════════════
# REQUIRED - Google Maps API
# ════════════════════════════════════════════════════════════════════
# Get your API key from: https://console.cloud.google.com/
# Enable the following APIs:
# - Geocoding API
# - Elevation API
MAPS_API_KEY=your_google_maps_api_key_here

# ════════════════════════════════════════════════════════════════════
# OPTIONAL - CORS Configuration
# ════════════════════════════════════════════════════════════════════
# For production, set to your frontend domain(s)
# Multiple domains: separate with commas
# Default: * (allow all origins - NOT recommended for production)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# ════════════════════════════════════════════════════════════════════
# OPTIONAL - Debug Mode
# ════════════════════════════════════════════════════════════════════
# Set to "true" to show detailed error messages in API responses
# NEVER enable in production!
# Default: false
DEBUG=false

# ════════════════════════════════════════════════════════════════════
# OPTIONAL - Server Configuration
# ════════════════════════════════════════════════════════════════════
# Backend server host and port
# Default: 0.0.0.0:8001
# HOST=0.0.0.0
# PORT=8001

# ════════════════════════════════════════════════════════════════════
# NOTES
# ════════════════════════════════════════════════════════════════════
# - Open-Meteo APIs are FREE and require NO API key
# - Google Maps APIs have a free tier with $200/month credit
# - For production deployment:
#   1. Set ALLOWED_ORIGINS to your domain
#   2. Keep DEBUG=false
#   3. Use strong API key restrictions in Google Cloud Console
#   4. Monitor API usage in Google Cloud Console
